# Local defaults; change the password before deploying.
POSTGRES_DB=finpilot
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot_local
# Compose overrides PGHOST to postgres for web.
PGHOST=127.0.0.1
PGPORT=5432
PORT=3000

# Optional: leave empty for the existing mock AI fallback.
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=MiniMax-M3
